; *************************************************************
; *** Scatter-Loading Description File for SmartWatch Bootloader
; *** Flash: Sector 0~4 (0x08000000 - 0x08020000, 128 KB)    ***
; *** SRAM:  0x20000000 - 0x20020000 (128 KB)                ***
; *************************************************************

LR_IROM1 0x08000000 0x00020000  {    ; load region size_region (128 KB)
  ER_IROM1 0x08000000 0x00020000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; RW data
   .ANY (+RW +ZI)
  }
}
